# 백엔드 환경변수 예시. 이 파일을 복사해서 backend/.env 로 만들고 값을 채운다.
# backend/.env 는 git 에 올라가지 않는다(.gitignore). 실제 키는 .env 에만 넣는다.

# ── 데이터베이스 (docker compose up -d 로 띄운 PostgreSQL 기본값) ──
DATABASE_URL=postgresql+psycopg://aimbank:aimbank@localhost:5432/aimbank

# ── 가계부 자연어 해석 (LLM) ──
# rules : 규칙 기반 해석만 사용 (키 없이도 동작, 기본값)
# llm   : Gemini 로 먼저 해석하고, 실패하거나 느리면 규칙 해석으로 되돌린다
LEDGER_NLU=rules

# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=

# 사용할 모델 이름. 질문 해석만 하므로 가볍고 빠른 모델이면 충분하다.
GEMINI_MODEL=gemini-3.6-flash

# LLM 응답을 기다리는 최대 시간(초). 넘기면 규칙 해석으로 되돌린다.
GEMINI_TIMEOUT_SEC=4

# 답변 문장 생성 (규칙이 확정한 사실을 LLM 이 말투로 풀어씀). rules 면 기존 템플릿 문장만 쓴다. 비우면 LEDGER_NLU 를 따른다.
LEDGER_ANSWER=llm

# ── 로그인 세션 ──
# 세션 쿠키 서명 키. 비워 두면 개발용 기본값을 쓴다. 배포 전에는 길고 무작위인 값으로 바꾼다.
SESSION_SECRET=
